{
  "name": "mqtt-multiplayer-messaging",
  "version": "0.1.0",
  "description": "Zero-dependency star-topology multiplayer room transport over MQTT-over-WSS for browser games.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
